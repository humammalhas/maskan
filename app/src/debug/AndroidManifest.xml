<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
         Debug builds only. Merged into the debug manifest, never into release.
    -->
    <application>
        <receiver
            android:name="app.maskan.chat.debug.ClipReceiver"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name="app.maskan.chat.debug.LlmProbeReceiver"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name="app.maskan.chat.debug.BackupProbeReceiver"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name="app.maskan.chat.debug.ProviderProbeReceiver"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name="app.maskan.chat.debug.AssemblyProbeReceiver"
            android:enabled="true"
            android:exported="true" />
        <!-- adb `am start` route to the probes, for a ROM that drops adb broadcasts (Honor). -->
        <activity
            android:name="app.maskan.chat.debug.ProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
